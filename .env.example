# Target database connection string
# PostgreSQL:  postgresql+asyncpg://user:password@localhost:5432/dbname
# MySQL:       mysql+aiomysql://user:password@localhost:3306/dbname
# SQLite:      sqlite+aiosqlite:///path/to/db.sqlite3
DATABASE_URL=postgresql+asyncpg://mercer:mercer@localhost:5432/mercer_dev

# Redis for schema cache
REDIS_URL=redis://localhost:6379/0

# SGLang inference server (Phase 3+)
SGLANG_URL=http://localhost:30000

# LLM API keys (for API fallback / Phase 0 baseline)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Inference backend: "sglang" | "anthropic" | "openai"
INFERENCE_BACKEND=anthropic

# Logging level: "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO
