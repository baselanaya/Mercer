# Target database connection string
# PostgreSQL:  postgresql+asyncpg://user:password@localhost:5432/dbname
# MySQL:       mysql+aiomysql://user:password@localhost:3306/dbname
# SQLite:      sqlite+aiosqlite:///path/to/db.sqlite3
DATABASE_URL=postgresql+asyncpg://mercer:mercer@localhost:5432/mercer_dev

# Redis for schema cache
REDIS_URL=redis://localhost:6379/0

# llama.cpp inference server (OpenAI-compatible endpoint)
# Start with: bash scripts/serve_llamacpp_turboquant.sh
LLAMACPP_URL=http://localhost:8080

# Local GGUF model file. The default points at Snowflake's Arctic-Text2SQL-R1-7B
# (Apache 2.0), an RL-tuned Qwen2.5-Coder fine-tune that scores ~68.9% on
# BIRD-dev — same VRAM footprint as the off-the-shelf Qwen, ~10pp better.
# Override to use any other GGUF: e.g. Qwen2.5-Coder-7B-Instruct-IQ4_XS.gguf
# See docs/custom-models.md for the swap rationale.
LOCAL_MODEL_PATH=models/Arctic-Text2SQL-R1-7B-IQ4_XS.gguf

# LLM API keys (for API fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Inference backend: "llamacpp" | "anthropic" | "openai"
INFERENCE_BACKEND=llamacpp

# Logging level: "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO

# Optional: API key for protecting the /query endpoint (leave blank to disable)
# MERCER_API_KEY=
